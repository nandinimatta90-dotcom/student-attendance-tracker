# ============================================
# Git Ignore - Student Attendance Tracker
# ============================================

# Operating System Files
.DS_Store
Thumbs.db
*.swp
*~

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.factorypath
.nb-gradle/
.history/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# Backend (Java / Maven)
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar
*.class

# Frontend (Node / React / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# General Logs & Dumps
*.log
logs/
*.dump
*.sql.gz
